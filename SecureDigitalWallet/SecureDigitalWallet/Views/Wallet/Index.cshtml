@model IEnumerable<WalletIndexViewModel>

@{
    ViewData["Title"] = "Wallets";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Wallets</h1>
    <a class="btn btn-primary" asp-action="Create">Create Wallet</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No wallets yet. Create your first one!</div>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Name</th>
                <th>Wallet Number</th>
                <th>Currency</th>
                <th>Balance</th>
                <th>Created</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var wallet in Model)
            {
                <tr>
                    <td>@wallet.Name</td>
                    <td>@wallet.WalletNumber</td>
                    <td>@wallet.Currency</td>
                    <td>@wallet.Balance.ToString("N2")</td>
                    <td>@wallet.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>
                        <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@wallet.Id">Details</a>
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@wallet.Id">Edit</a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@wallet.Id">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
