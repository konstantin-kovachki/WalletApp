@model WalletDetailsViewModel

@{
    ViewData["Title"] = "Wallet Details";
}

<h1>@Model.Name</h1>

<div class="card mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Model.Name</dd>

            <dt class="col-sm-3">Wallet Number</dt>
            <dd class="col-sm-9">@Model.WalletNumber</dd>

            <dt class="col-sm-3">Currency</dt>
            <dd class="col-sm-9">@Model.Currency</dd>

            <dt class="col-sm-3">Balance</dt>
            <dd class="col-sm-9">@Model.Balance.ToString("N2") @Model.Currency</dd>

            <dt class="col-sm-3">Created</dt>
            <dd class="col-sm-9">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>
        </dl>
    </div>
</div>

<h2>Transactions</h2>

@if (Model.Transactions.Count == 0)
{
    <p class="text-muted">No transactions for this wallet yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr><th>Date</th><th>Type</th><th>Amount</th><th>Description</th></tr>
        </thead>
        <tbody>
            @foreach (TransactionViewModel t in Model.Transactions)
            {
                <tr>
                    <td>@t.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@t.Type</td>
                    <td>@t.Amount.ToString("N2")</td>
                    <td>@t.Description</td>
                </tr>
            }
        </tbody>
    </table>
}

<a class="btn btn-outline-secondary" asp-action="Index">Back to list</a>
<a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
